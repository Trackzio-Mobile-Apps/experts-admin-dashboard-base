# Local development only. Copy to `.env.local` (never commit real values).
# Do NOT put secrets in git. Set production values in the Netlify dashboard.

# --- Brand this deploy (same codebase, different product) ---
# Defaults are Coinzy. Change these four to ship another app.
# See docs/branding-a-new-app.md
NEXT_PUBLIC_APP_NAME=Coinzy
NEXT_PUBLIC_APP_ICON=C
NEXT_PUBLIC_APP_COLOR=#7c3c3f
NEXT_PUBLIC_API_BASE_URL=https://coinzy-experts-api.trackzio.com
# Optional: stable id (defaults from the name). Use when the Netlify branch name differs.
# NEXT_PUBLIC_APP_ID=coinzy
# Optional: sidebar hex (defaults to a slightly darker primary).
# NEXT_PUBLIC_APP_SIDEBAR=#823f42
# Optional: comma-separated labels under the sidebar logo.
# NEXT_PUBLIC_APP_MODELS=Coin evaluation

# Optional local reference only — operators enter this on the login page.
# Do NOT put ADMIN_API_KEY in Netlify env vars.
# ADMIN_API_KEY=

# Firebase web app config (from Firebase Console → Project settings → Your apps)
# Required keys for profile image upload; leave blank here and fill in `.env.local` / Netlify UI.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional: default inbox shown on Reports / Settings (safe to expose).
# NEXT_PUBLIC_REPORT_RECIPIENT_EMAIL=ops@example.com

# Server-only. Needed for automatic weekly/monthly report emails (Netlify).
# Do NOT prefix these with NEXT_PUBLIC_.
# RESEND_API_KEY=
# REPORT_FROM_EMAIL=Coinzy Admin <reports@your-verified-domain.com>
# REPORT_RECIPIENT_EMAIL=ops@example.com
# REPORT_ADMIN_API_KEY=
# CRON_SECRET=
