# Template for Netlify Environment Variables (Dashboard only).
# Never commit real secrets. Never bake ADMIN_API_KEY into the deployment.
#
# In Netlify → Site configuration → Environment variables, add ONLY:
#
#   NEXT_PUBLIC_API_BASE_URL
#   NEXT_PUBLIC_FIREBASE_API_KEY
#   NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN
#   NEXT_PUBLIC_FIREBASE_PROJECT_ID
#   NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET
#   NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID
#   NEXT_PUBLIC_FIREBASE_APP_ID
#   NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID   (optional)
#
# Scopes: Production (+ Deploy Previews / Branch deploys as needed).
# Trigger a new deploy after saving.
#
# Optional — weekly (Monday 08:00 UTC) and monthly (1st 08:00 UTC) report emails.
# These are server-only. Never prefix with NEXT_PUBLIC_.
#   NEXT_PUBLIC_ADMIN_APPS              (optional JSON list of apps)
#   NEXT_PUBLIC_REPORT_RECIPIENT_EMAIL   (optional default shown in the UI)
#   REPORT_RECIPIENT_EMAIL
#   REPORT_FROM_EMAIL                    (verified Resend from-address)
#   RESEND_API_KEY
#   REPORT_ADMIN_API_KEY                 (server copy of the admin key, cron only)
#   CRON_SECRET
#
# Do NOT add:
#   ADMIN_API_KEY          (entered by ops on the login page)
#   any .env.local contents into git

NEXT_PUBLIC_API_BASE_URL=
# NEXT_PUBLIC_ADMIN_APPS=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
