# Template for Netlify Environment Variables (Dashboard only).
# Never commit real secrets. Never bake ADMIN_API_KEY into the deployment.
#
# In Netlify → Site configuration → Environment variables, add ONLY:
#
#   APP_NAME                             (brand, e.g. Coinzy)
#   APP_ICON                             (1–2 letters shown in the logo)
#   APP_COLOR                            (hex, e.g. #7c3c3f)
#   API_BASE_URL
#   APP_ID                               (optional slug; defaults from the name)
#   APP_SIDEBAR                          (optional hex)
#   APP_MODELS                           (optional, comma-separated)
#   FIREBASE_API_KEY
#   FIREBASE_AUTH_DOMAIN
#   FIREBASE_PROJECT_ID
#   FIREBASE_STORAGE_BUCKET
#   FIREBASE_MESSAGING_SENDER_ID
#   FIREBASE_APP_ID
#   FIREBASE_MEASUREMENT_ID              (optional)
#
# Scopes: Production (+ Deploy Previews / Branch deploys as needed).
# Trigger a new deploy after saving. Public values are baked in at build time.
#
# Optional — weekly (Monday 08:00 UTC) and monthly (1st 08:00 UTC) report emails.
#   REPORT_RECIPIENT_EMAIL               (inbox for UI default + cron)
#   REPORT_FROM_EMAIL                    (verified Resend from-address)
#   RESEND_API_KEY
#   REPORT_ADMIN_API_KEY                 (server copy of the admin key, cron only)
#   CRON_SECRET
#
# Do NOT add:
#   ADMIN_API_KEY          (entered by ops on the login page)
#   any .env.local contents into git

APP_NAME=
APP_ICON=
APP_COLOR=
API_BASE_URL=
# APP_ID=
# APP_SIDEBAR=
# APP_MODELS=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
